{
  "info": {
    "_postman_id": "2f9e20e7-26c2-4d65-9cf3-board-project",
    "name": "Board Project",
    "description": "Spring Boot Thymeleaf board project requests. This project uses form submissions and session cookies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "postId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Page",
      "item": [
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Board Main",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/main?page=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "main"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "H2 Console",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/h2-console"
          }
        }
      ]
    },
    {
      "name": "Member",
      "item": [
        {
          "name": "Signup Form",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/members/new"
          }
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "junho",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "junho@example.com",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/members"
          }
        },
        {
          "name": "Login Form",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/members/login"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "junho",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/members/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/members/logout"
          }
        }
      ]
    },
    {
      "name": "Post",
      "description": "Run Member/Login first so Postman stores the session cookie.",
      "item": [
        {
          "name": "New Post Form",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/new"
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "title",
                  "value": "First post",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Hello board",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Post Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Edit Post Form",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}/edit"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "title",
                  "value": "Updated post",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Updated content",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/posts/{{postId}}/edit"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}/delete"
          }
        }
      ]
    }
  ]
}
